# Copy to your host's environment settings (Vercel → Project → Settings → Environment Variables).
# Nothing here is required: without these the site builds and the contact form hands briefs to email/WhatsApp.

# Canonical origin used for canonical URLs, sitemap, Open Graph and the API's same-origin check.
SITE_ORIGIN=https://your-domain.example

# Contact form delivery via Resend (https://resend.com). Both must be set to enable server-side sending.
RESEND_API_KEY=
ENQUIRY_TO=owner@your-domain.example
# Must be a sender on a domain verified in Resend; defaults to Resend's test sender.
ENQUIRY_FROM=Website brief <brief@your-domain.example>

# Optional Cloudflare Turnstile spam check. The site key is read at build time; the secret at request time.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Build a release (fails if any photo on the site still lacks recorded consent). Same as `npm run build:release`.
RELEASE=
