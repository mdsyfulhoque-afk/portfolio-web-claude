/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-qZmE3QkUBvXpmn+Uq1YdoI0Ubk+fgP3h4a4uSLXyNN8=' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'; upgrade-insecure-requests
